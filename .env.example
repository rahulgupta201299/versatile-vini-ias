# Backend API — leave empty to use the local data in src/data (useful for development)
API_BASE_URL=https://api.viniias.com/v1
# Optional bearer token sent with every API request
API_TOKEN=
# Request timeout in ms (falls back to local data on timeout)
API_TIMEOUT_MS=8000
# Secret for POST /api/revalidate (on-demand cache refresh from the backend / CMS)
REVALIDATE_SECRET=change-me
