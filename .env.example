# Backend API — leave empty to use the local data in src/data (useful for development)
API_BASE_URL=https://api.viniias.com/v1
# Optional bearer token sent with every API request
API_TOKEN=
# Request timeout in ms (falls back to local data on timeout)
API_TIMEOUT_MS=8000
# Secret for POST /api/revalidate (on-demand cache refresh from the backend / CMS)
REVALIDATE_SECRET=change-me

# Careers "Apply for this role" — phone OTP verification.
# demo (default): no SMS/WhatsApp is sent; the code is 123456 (for testing only).
# live: OTP send/verify and applications are forwarded to API_BASE_URL (/careers/otp/send, /careers/otp/verify, /careers/apply).
CAREERS_OTP_MODE=demo
# Secret used to sign the "phone verified" token between OTP and application submit
CAREERS_OTP_SECRET=change-me-too
